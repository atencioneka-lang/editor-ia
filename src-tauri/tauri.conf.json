{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Editor IA",
  "version": "0.2.0",
  "identifier": "app.editoria.local",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Editor IA",
        "width": 1400,
        "height": 900,
        "minWidth": 860,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
